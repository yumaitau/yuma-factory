# Build-time branding (inlined by Next.js). Both optional.
NEXT_PUBLIC_APP_NAME=Factory
# Prefix for Factory-owned GitHub labels: <prefix>:ready, <prefix>:done, <prefix>:risk:*.
# Must match LABEL_PREFIX on the sandbox runner.
NEXT_PUBLIC_LABEL_PREFIX=factory

BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=example.com
GOOGLE_CLIENT_ID=required-google-workspace-oauth-client-id
GOOGLE_CLIENT_SECRET=required-google-workspace-oauth-client-secret
E2E_DISABLE_AUTH_RATE_LIMIT=0
